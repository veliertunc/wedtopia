# Merge with your original .env values. Never commit real keys.
WEDDINGS_GATEWAY_URL=http://localhost:3001
WEDDINGS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
EXPO_PUBLIC_WEDDINGS_GATEWAY_URL=http://localhost:3001
GOOGLE_MAPS_API_KEY=
UBER_CLIENT_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OTHER_AI_API_KEY=
# Replace model identifiers and cost weights with values verified for your accounts.
# Weights rank relative cost; they are not exact billed token estimates.
WEDDINGS_AI_MODELS=[{"id":"openai-economy","provider":"openai","model":"YOUR_OPENAI_MODEL","keyEnv":"OPENAI_API_KEY","inputCost":1,"outputCost":1},{"id":"claude-economy","provider":"anthropic","model":"YOUR_CLAUDE_MODEL","keyEnv":"ANTHROPIC_API_KEY","inputCost":1,"outputCost":1}]
# For another provider add an entry with provider=compatible and an HTTPS baseUrl ending in /v1.
WEDDINGS_ENABLE_SAMPLE_REQUESTS=false
