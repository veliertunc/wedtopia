{
  "name": "@acme/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./weddings/domain": {
      "types": "./dist/weddings/domain.d.ts",
      "default": "./src/weddings/domain.ts"
    },
    "./weddings/marketplace": {
      "types": "./dist/weddings/marketplace.d.ts",
      "default": "./src/weddings/marketplace.ts"
    },
    "./weddings/readiness": {
      "types": "./dist/weddings/readiness.d.ts",
      "default": "./src/weddings/readiness.ts"
    },
    "./weddings/saved-plans": {
      "types": "./dist/weddings/saved-plans.d.ts",
      "default": "./src/weddings/saved-plans.ts"
    },
    "./weddings/service": {
      "types": "./dist/weddings/service.d.ts",
      "default": "./src/weddings/service.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@acme/auth": "workspace:*",
    "@acme/db": "workspace:*",
    "@acme/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "superjson": "2.2.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
